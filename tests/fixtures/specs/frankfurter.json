{
  "spec_version": "1",
  "name": "Frankfurter",
  "base_url": "https://api.frankfurter.dev/v2",
  "description": "",
  "auth": {
    "type": "none"
  },
  "endpoints": [
    {
      "id": "get_rates",
      "method": "GET",
      "path": "/rates",
      "summary": "Get the latest or historical exchange rates for a base currency.",
      "description": "Add date for a historical rate, from and to for a time series, and group to downsample it. Add expand=providers to see the providers behind each blended rate.",
      "parameters": [
        {
          "name": "base",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Base currency code."
        },
        {
          "name": "quotes",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Comma-separated target currency codes."
        },
        {
          "name": "date",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Date of a historical rate, YYYY-MM-DD."
        },
        {
          "name": "from",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Start date of a time series, YYYY-MM-DD."
        },
        {
          "name": "to",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "End date of a time series, YYYY-MM-DD."
        },
        {
          "name": "group",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Downsample a time series.",
          "enum": [
            "week",
            "month"
          ]
        },
        {
          "name": "providers",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Restrict rates to a provider or dataset key, e.g. ecb."
        },
        {
          "name": "expand",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Add per-provider rates to each row.",
          "enum": [
            "providers"
          ]
        }
      ],
      "source_url": "https://frankfurter.dev/#rates"
    },
    {
      "id": "get_rates_csv",
      "method": "GET",
      "path": "/rates.csv",
      "summary": "Get exchange rates as CSV.",
      "description": "The same output is available by setting the Accept header to text/csv on /v2/rates.",
      "parameters": [],
      "source_url": "https://frankfurter.dev/#csv"
    },
    {
      "id": "get_rate",
      "method": "GET",
      "path": "/rate/{base}/{quote}",
      "summary": "Get the rate for a single currency pair.",
      "description": "Optionally add date or providers.",
      "parameters": [
        {
          "name": "base",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Base currency code."
        },
        {
          "name": "quote",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Quote currency code."
        },
        {
          "name": "date",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Date of the rate, YYYY-MM-DD."
        },
        {
          "name": "providers",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Restrict the rate to a provider or dataset key."
        }
      ],
      "source_url": "https://frankfurter.dev/#rate"
    },
    {
      "id": "list_currencies",
      "method": "GET",
      "path": "/currencies",
      "summary": "List available currencies with provider coverage.",
      "description": "",
      "parameters": [
        {
          "name": "scope",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Set to all to include legacy currencies.",
          "enum": [
            "all"
          ]
        }
      ],
      "source_url": "https://frankfurter.dev/#rate"
    },
    {
      "id": "get_currency",
      "method": "GET",
      "path": "/currency/{currency}",
      "summary": "Get details and provider coverage for a single currency.",
      "description": "",
      "parameters": [
        {
          "name": "currency",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Currency code."
        }
      ],
      "source_url": "https://frankfurter.dev/#currency"
    },
    {
      "id": "list_providers",
      "method": "GET",
      "path": "/providers",
      "summary": "List the providers behind the API.",
      "description": "",
      "parameters": [],
      "source_url": "https://frankfurter.dev/#currency"
    },
    {
      "id": "get_provider",
      "method": "GET",
      "path": "/providers/{provider}",
      "summary": "Get details for a single provider, including its datasets.",
      "description": "",
      "parameters": [
        {
          "name": "provider",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Provider key, e.g. ecb."
        }
      ],
      "source_url": "https://frankfurter.dev/#currency"
    },
    {
      "id": "get_provider_rates",
      "method": "GET",
      "path": "/providers/{provider}/rates",
      "summary": "Get rates directly from a specific provider.",
      "description": "Combine with date, date ranges (from and to), or grouping. Formats like csv and ndjson also work.",
      "parameters": [
        {
          "name": "provider",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Provider key, e.g. ecb."
        },
        {
          "name": "date",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Date of the rate, YYYY-MM-DD."
        },
        {
          "name": "from",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Start date of a time series, YYYY-MM-DD."
        },
        {
          "name": "to",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "End date of a time series, YYYY-MM-DD."
        },
        {
          "name": "group",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Downsample a time series.",
          "enum": [
            "week",
            "month"
          ]
        },
        {
          "name": "base",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Base currency code."
        },
        {
          "name": "quotes",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Comma-separated target currency codes."
        },
        {
          "name": "providers",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Restrict rates to a provider or dataset key, e.g. ecb."
        },
        {
          "name": "expand",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Add per-provider rates to each row.",
          "enum": [
            "providers"
          ]
        }
      ],
      "source_url": "https://frankfurter.dev/#rates-by-provider"
    },
    {
      "id": "get_provider_rate",
      "method": "GET",
      "path": "/providers/{provider}/rate/{base}/{quote}",
      "summary": "Get a single currency pair rate from a specific provider.",
      "description": "",
      "parameters": [
        {
          "name": "provider",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Provider key, e.g. ecb."
        },
        {
          "name": "base",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Base currency code."
        },
        {
          "name": "quote",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Quote currency code."
        }
      ],
      "source_url": "https://frankfurter.dev/#rates-by-provider"
    }
  ]
}