# Copy to .env and fill in. Never commit .env.

# Needed only for steps that call a model (extraction, design, evals).
ANTHROPIC_API_KEY=

# Claude model for extraction and design.
DOCS2MCP_MODEL=claude-haiku-5-5

# Timeout for fetching documentation pages, in seconds.
DOCS2MCP_HTTP_TIMEOUT_SECONDS=30

# Ingest
DOCS2MCP_CACHE_DIR=.cache/docs2mcp
DOCS2MCP_INGEST_MAX_PAGES=20
DOCS2MCP_CRAWL_DELAY_SECONDS=0.5
DOCS2MCP_CHUNK_MAX_TOKENS=1500
DOCS2MCP_CHUNK_MIN_TOKENS=80

# Extract
DOCS2MCP_EXTRACT_BATCH_TOKENS=6000
DOCS2MCP_EXTRACT_MAX_OUTPUT_TOKENS=16000
DOCS2MCP_EXTRACT_MAX_RETRIES=2
DOCS2MCP_EXTRACT_PROMPT_CACHE=true

# Design
DOCS2MCP_DESIGN_MODEL=claude-sonnet-5-5
DOCS2MCP_DESIGN_MAX_OUTPUT_TOKENS=32000
DOCS2MCP_DESIGN_MAX_RETRIES=2
