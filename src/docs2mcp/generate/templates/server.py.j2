BASE_URL = {{ base_url | py }}
MAX_RESULT_CHARS = int(os.environ.get("DOCS2MCP_MAX_RESULT_CHARS", "{{ max_result_chars }}"))
TIMEOUT_SECONDS = float(os.environ.get("DOCS2MCP_TIMEOUT_SECONDS", "30"))
MAX_REDIRECTS = 5
API_KEY_ENV = {{ auth.env | py }}
USER_AGENT = "docs2mcp-generated-server/{{ version }}"

Location = Literal["path", "query", "header", "body"]


class Route(TypedDict):
    method: str
    path: str
    requires: list[str]
    arguments: dict[str, tuple[str, Location]]
    constants: list[tuple[str, Location, Any]]


{% if aliases %}
{{ aliases }}

