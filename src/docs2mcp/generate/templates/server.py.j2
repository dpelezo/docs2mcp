"""MCP server for {{ api }}, generated by docs2mcp {{ version }} from tools.json.

Do not edit this file: change tools.json and run `docs2mcp generate` again.
Run it with `uv run server.py` (stdio) or `uv run server.py --http` (streamable HTTP).
"""

import argparse
import json
import os
from typing import Annotated, Any, Literal, TypedDict
from urllib.parse import quote

import httpx
from mcp.server.mcpserver import MCPServer
from mcp.server.mcpserver.exceptions import ToolError
from pydantic import Field

BASE_URL = {{ base_url | py }}
MAX_RESULT_CHARS = int(os.environ.get("DOCS2MCP_MAX_RESULT_CHARS", "{{ max_result_chars }}"))
TIMEOUT_SECONDS = float(os.environ.get("DOCS2MCP_TIMEOUT_SECONDS", "30"))
API_KEY_ENV = {{ auth.env | py }}
USER_AGENT = "docs2mcp-generated-server/{{ version }}"

Location = Literal["path", "query", "header", "body"]


class Route(TypedDict):
    method: str
    path: str
    requires: list[str]
    arguments: dict[str, tuple[str, Location]]
    constants: list[tuple[str, Location, Any]]


ROUTES: dict[str, list[Route]] = {
{% for tool in tools %}
    {{ tool.name | py }}: [
{% for route in tool.routes %}
        {
            "method": {{ route.method | py }},
            "path": {{ route.path | py }},
            "requires": {{ route.requires | py }},
            "arguments": {{ route.arguments | py }},
            "constants": {{ route.constants | py }},
        },
{% endfor %}
    ],
{% endfor %}
}

mcp: MCPServer = MCPServer(
    name={{ api | py }},
    instructions={{ ("Tools for the " ~ api ~ " API at " ~ base_url ~ ". Each tool makes one request.") | py }},
)

# Tests replace this with an httpx.MockTransport, so no request leaves the process.
transport: httpx.BaseTransport | None = None


def _text(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, list):
        return ",".join(_text(item) for item in value)  # pyright: ignore[reportUnknownVariableType]
    return str(value)


def _auth(headers: dict[str, str], query: dict[str, str]) -> None:
{% if auth.kind == "api_key" %}
    key = os.environ.get(API_KEY_ENV)
    if not key:
        return  # some APIs take a key only for paid use; one that needs it answers 401
{% if auth.location == "query" %}
    query[{{ auth.name | py }}] = key
{% else %}
    headers[{{ auth.name | py }}] = key
{% endif %}
{% elif auth.kind == "bearer" %}
    key = os.environ.get(API_KEY_ENV)
    if not key:
        return  # an API that needs the token answers 401
    headers["Authorization"] = f"Bearer {key}"
{% else %}
    del headers, query  # the API needs no credentials
{% endif %}


def _choose(tool: str, given: dict[str, Any]) -> Route:
    for route in ROUTES[tool]:
        if all(name in given for name in route["requires"]):
            return route
    options = " or ".join(", ".join(r["requires"]) or "nothing" for r in ROUTES[tool])
    raise ToolError(f"{tool} needs one of these argument sets: {options}")


def call(tool: str, arguments: dict[str, Any]) -> str:
    """Pick the first route whose required arguments are given, make the request, return JSON text."""
    given = {name: value for name, value in arguments.items() if value is not None}
    route = _choose(tool, given)
    path = route["path"]
    query: dict[str, str] = {}
    headers: dict[str, str] = {"User-Agent": USER_AGENT, "Accept": "application/json"}
    body: dict[str, Any] = {}
    values = [(*route["arguments"][name], value) for name, value in given.items() if name in route["arguments"]]
    for name, location, value in [*values, *route["constants"]]:
        if location == "path":
            path = path.replace("{" + name + "}", quote(_text(value), safe=""))
        elif location == "query":
            query[name] = _text(value)
        elif location == "header":
            headers[name] = _text(value)
        else:
            body[name] = value
    _auth(headers, query)

    try:
        with httpx.Client(base_url=BASE_URL, timeout=TIMEOUT_SECONDS, transport=transport) as client:
            response = client.request(
                route["method"], path, params=query, headers=headers, json=body or None
            )
    except httpx.HTTPError as error:
        raise ToolError(f"{route['method']} {path} failed: {error}") from error
    if response.is_error:
        raise ToolError(
            f"{route['method']} {path} returned HTTP {response.status_code}: {response.text[:500]}"
        )
    try:
        text = json.dumps(response.json(), ensure_ascii=False)
    except ValueError:
        kind = response.headers.get("content-type", "unknown")
        text = f"[The response is {kind}, not JSON]\n{response.text}"
    if len(text) > MAX_RESULT_CHARS:
        shown = text[:MAX_RESULT_CHARS]
        text = f"{shown}\n[Cut to {MAX_RESULT_CHARS} of {len(text)} characters. Narrow the request.]"
    return text
{% for tool in tools %}


@mcp.tool(name={{ tool.name | py }}, description={{ tool.description | py }})
def {{ tool.name }}(
{% for p in tool.parameters %}
    {{ p.name }}: {{ p.annotation }}{% if not p.required %} = None{% endif %},
{% endfor %}
) -> str:
    return call({{ tool.name | py }}, {
{% for p in tool.parameters %}
        {{ p.name | py }}: {{ p.name }},
{% endfor %}
    })
{% endfor %}


def main() -> None:
    parser = argparse.ArgumentParser(description={{ ("MCP server for " ~ api) | py }})
    parser.add_argument("--http", action="store_true", help="serve streamable HTTP instead of stdio")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()
    if args.http:
        mcp.run("streamable-http", host=args.host, port=args.port, stateless_http=True)
    else:
        mcp.run("stdio")


if __name__ == "__main__":
    main()
