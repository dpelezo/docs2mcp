# Generated by docs2mcp {{ version }}. Regenerate instead of editing.
[project]
name = "{{ slug }}-mcp"
version = "0.1.0"
description = {{ ("MCP server for " ~ api ~ ", generated by docs2mcp") | toml }}
requires-python = ">=3.14"
dependencies = [
    "httpx>=0.28.1,<1",
    "mcp>=2.3,<3",
    "pydantic>=2.14,<3",
]

[tool.uv]
package = false

# The checks docs2mcp runs on every generated server (#31).
[tool.ruff]
line-length = 100
target-version = "py314"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "SIM", "RET", "PL"]
ignore = [
    "B008",     # Field(...) defaults are how the MCP SDK reads argument descriptions
    "PLR0913",  # a tool takes one argument per API parameter
    "PLR0917",
]

[tool.pyright]
typeCheckingMode = "strict"
pythonVersion = "3.14"
